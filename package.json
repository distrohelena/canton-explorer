{
  "name": "canton-node-explorer-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": "https://github.com/distrohelena/canton-explorer",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "overrides": {
    "dompurify": "3.4.13"
  },
  "scripts": {
    "postinstall": "node scripts/patch-monaco-dompurify.mjs",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "lint": "npm run lint --workspace backend && npm run lint --workspace frontend",
    "dev:backend": "npm run start:dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "start:frontend": "npm run build --workspace frontend && npm run start --workspace frontend",
    "build:package": "npm run build:package --workspace backend",
    "pack:dry-run": "npm run pack:dry-run --workspace backend",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "test:screenshots": "node --test scripts/capture-screenshots.test.mjs scripts/screenshot-*.test.mjs",
    "test:docker:image": "node --test scripts/docker-image.test.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.0"
  }
}
