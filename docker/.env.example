CANTON_EXPLORER_VERSION=latest
CANTON_EXPLORER_PORT=4600

# Define every credential-bearing variable referenced by config/nodes.local.json
# before starting the client. Do not commit real credentials to .env.
PARTICIPANT_1_PQS_URL=postgres://<username>:<password>@<pqs-host>:<port>/<database>
CANTON_STATIC_TOKEN=<static-bearer-token>
